rder-bottom:none}\n.plan-list li::before{content:\"\";position:absolute;left:2px;top:20px;width:8px;height:8px;background:var(--mint-dark);transform:rotate(45deg)}\n.plans-foot{font-size:13.5px;color:var(--muted);border-top:1px solid var(--line);padding-top:20px;margin-top:6px;line-height:1.75}\n\n/* ---------- clients ---------- */\n.clients-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}\n.client{border:1px solid var(--line);background:#fffdf8;padding:28px 26px 26px;position:relative}\n.client .num{font-family:ui-monospace,\"SFMono-Regular\",Menlo,monospace;font-size:12px;letter-spacing:.2em;color:var(--mint-dark);display:block;margin-bottom:14px}\n.client h3{font-size:1.15rem;margin:0 0 12px;color:var(--brown);font-weight:800}\n.client p{margin:0 0 14px;font-size:15px;color:#3a2a1d}\n.client .meta{font-size:12.8px;color:var(--muted);border-top:1px dashed var(--line);padding-top:12px;margin:0}\n.client .meta a{font-size:12.8px}\n\n/* ---------- howto ---------- */\n.howto{background:var(--brown);color:#efe4d6}\n.howto .section-head{border-bottom-color:rgba(159,231,207,.35)}\n.howto h2{color:#fbf5ec}\n.howto .section-no{color:var(--mint)}\n.howto .section-head p{color:#bda893}\n.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:2px;background:rgba(159,231,207,.28)}\n.step{background:var(--brown);padding:28px 22px 24px;position:relative}\n.step .s-no{font-family:ui-monospace,\"SFMono-Regular\",Menlo,monospace;font-size:46px;font-weight:700;line-height:1;color:rgba(159,231,207,.35);display:block;margin-bottom:16px}\n.step h3{font-size:15.5px;margin:0 0 10px;color:var(--mint);font-weight:700;letter-spacing:.02em}\n.step p{margin:0;font-size:14.5px;color:#d8c8b6;line-height:1.7}\n\n/* ---------- faq ---------- */\n.faq-list{display:flex;flex-direction:column;gap:12px}\ndetails.qa{border:1px solid var(--line);background:#fffdf8;padding:0}\ndetails.qa[open]{border-left:5px solid var(--mint-dark);background:#fff}\ndetails.qa summary{cursor:pointer;list-style:none;padding:20px 56px 20px 24px;font-size:1.02rem;font-weight:700;color:var(--brown);position:relative;line-height:1.6}\ndetails.qa summary::-webkit-details-marker{display:none}\ndetails.qa summary::after{content:\"＋\";position:absolute;right:22px;top:50%;transform:translateY(-50%);font-size:18px;color:var(--mint-dark);font-family:ui-monospace,monospace}\ndetails.qa[open] summary::after{content:\"－\";color:var(--brown-3)}\ndetails.qa .answer{padding:0 26px 22px 24px;font-size:15.5px;color:#382819;border-top:1px dashed var(--line);margin-top:-2px;padding-top:18px}\ndetails.qa .answer p{margin:0 0 12px}\ndetails.qa .answer p:last-child{margin-bottom:0}\n.faq-note{margin-top:26px;font-size:13.5px;color:var(--muted);border-top:1px solid var(--line);padding-top:18px;line-height:1.75}\n\n/* ---------- footer ---------- */\nfooter{background:var(--brown);color:#c9b7a4;padding:48px 0 38px;font-size:13.5px}\nfooter .wrap{display:flex;flex-wrap:wrap;gap:22px 44px;justify-content:space-between;align-items:flex-start}\nfooter strong{color:var(--mint);display:block;font-size:15px;margin-bottom:8px}\nfooter p{margin:0 0 6px;max-width:520px;line-height:1.75}\nfooter a{color:var(--mint);border-bottom:1px dotted rgba(159,231,207,.5)}\nfooter .fgrid{display:flex;flex-wrap:wrap;gap:10px 24px}\nfooter .fgrid a{border-bottom:none;font-size:13px}\n\n@media (max-width:900px){\n  .hero-lead{grid-template-columns:1fr}\n  .plan-card{grid-template-columns:1fr;gap:8px}\n  .clients-grid{grid-template-columns:1fr}\n  .steps{grid-template-columns:1fr 1fr}\n  .reading{grid-template-columns:1fr}\n  .section-head{flex-wrap:wrap}\n  .section-head p{margin:0;text-align:left;max-width:none}\n}\n@media (max-width:600px){\n  body{font-size:16px}\n  section{padding:52px 0}\n  .hero{padding:44px 0 52px}\n  .steps{grid-template-columns:1fr}\n  .plan-card{padding:28px 20px 24px}\n  .plan-card .bg-no{font-size:100px;bottom:-26px}\n  .side-note{padding:22px 18px}\n  details.qa summary{padding:18px 46px 18px 18px}\n  details.qa .answer{padding:16px 18px 20px}\n  .topnav{display:none}\n}\n</style><div class=\"topbar\">\n  <div class=\"wrap\">\n    <nav class=\"crumb\" aria-label=\"面包屑\">\n      <a href=\"#top\">水牛云</a>\n      <span class=\"sep\">/</span>\n      <a href=\"#plans\">资费与套餐</a>\n      <span class=\"sep\">/</span>\n      <span>使用说明与常见问题</span>\n    </nav>\n    <nav class=\"topnav\" aria-label=\"页面目录\">\n      <a href=\"#why\">为什么读这一页</a>\n      <a href=\"#plans\">套餐</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#howto\">使用路径</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n</div>\n\n<main id=\"top\">\n\n  \n  <header class=\"hero\">\n    <div class=\"wrap\">\n      <div class=\"hero-head\">\n        <span class=\"kicker\">水牛云 · 订阅说明</span>\n        <h1>水牛云：先想清楚每个月要花多少流量，<em>再决定开哪个档</em></h1>\n\n        <div class=\"hero-lead\">\n          <div class=\"hero-body\">\n            <p>大多数人在挑选网络接入服务时，最先看的是价格，最后才看流量。这顺序其实是反的。流量决定你用起来是否束手束脚，价格只决定你每个月在账单上看到多少数字。水牛云把套餐拆成三档，每档都标明月度流量、可同时在线的设备数量，以及该档位适合的使用场景，就是为了让这个顺序可以倒过来。</p>\n            <p>你可能已经注意到，我们在页面上没有写“极速”“一键”“全球”这类词。原因很简单：这些词描述的是感受，而不是你可以核对的事实。水牛云愿意被记住的是另外几样东西——每档套餐写清楚多少流量、多少台设备、哪类线路，按年付时价格是多少，以及这些问题在下方 FAQ 中逐条回答。</p>\n            <p>如果你只想知道结论：一个人、手机加电脑、偶尔看看流媒体，基础版通常够用；家里有几台设备、对线路优先级有要求，旗舰版更合适；小团队统一结算、需要多人同时在线，才轮到团队版。下面的正文会把每个判断的依据写出来，你可以逐段跳过，也可以从头读。</p>\n          </div>\n\n          <aside class=\"side-note\">\n            <h2>一页速览</h2>\n            <dl>\n              <dt>套餐档位</dt>\n              <dd>基础版 / 旗舰版 / 团队版，共三档</dd>\n              <dt>月度价格</dt>\n              <dd>¥15 · ¥35 · ¥85（每月）</dd>\n              <dt>年度价格</dt>\n              <dd>¥150 · ¥350 · ¥850（按年付）</dd>\n              <dt>设备数量</dt>\n              <dd>3 台 · 5 台 · 20 台同时在线</dd>\n              <dt>流量上限</dt>\n              <dd>100GB · 300GB · 1000GB 每月</dd>\n            </dl>\n            <p class=\"disclaimer\">以上价格与权益为本页列出的套餐说明。具体扣费周期、税费与结算方式以你实际订阅时看到的确认信息为准。</p>\n          </aside>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  \n  <section id=\"why\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <span class=\"section-no\">01 / 阅读路径</span>\n        <h2>这一页不打算说服你，只打算让你自己算得出来</h2>\n        <p>三段文字，一段关于流量，一段关于设备，一段关于线路。</p>\n      </div>\n\n      <div class=\"reading\">\n        <p>先从流量说起。流量是最容易被高估的一项。一个人刷图文、看短视频、偶尔下载文件，一个月的用量通常在几十 GB 这个区间；如果你还有居家办公、云盘同步、软件更新这类习惯，用量会明显上浮。基础版每月 100GB 的设计对象，就是那些“不需要每天看高清长视频”的用户。它不预留太多余量，因此价格也压得比较低。</p>\n        <p>再看设备。设备数量不是“你能登录几个账号”，而是“同一时间有多少台设备在线”。手机、平板、笔记本各自算一台。旗舰版给到 5 台，覆盖的典型场景是一个人的多设备，或者两个人的手机加电脑。团队版的 20 台，是给那些需要多人统一结算的小团队准备的，它并不适合单个用户拿来囤着。</p>\n        <div class=\"pull\">选套餐其实只有三问：<strong>每月大概会跑掉多少流量？</strong><strong>同一时刻会有几台设备在用？</strong><strong>你是否愿意为线路优先级和响应速度多付一点？</strong>三问答完，档位基本就定了。</div>\n        <p>第三问最容易被忽略。基础版用的是普通线路节点池，它满足日常访问没问题，但在高并发时段不承诺优先级。旗舰版和团队版则在这部分做了区分，前者包含 IPLC 专线游戏加速优化与全节点原生流媒体解锁，后者进一步提供 VIP 专属高带宽节点与企业定制路由。如果你对延迟敏感，或者需要在固定时段稳定使用，这部分的差别会比价格差别更重要。</p>\n        <p>最后提醒一句：按年付确实便宜。基础版年付 ¥150，相当于每月 ¥12.5；旗舰版 ¥350，每月约 ¥29.2；团队版 ¥850，每月约 ¥70.8。年付的好处是摊薄成本，代价是灵活性。如果你还没确定自己的实际用量，建议先按月付跑一个完整周期，再考虑切年付。</p>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"plans\" class=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <span class=\"section-no\">02 / 套餐</span>\n        <h2>三档套餐，按使用强度排列，从上往下读</h2>\n        <p>每档都写明月度价格、年度价格、流量上限与设备数量，不做隐藏区分。</p>\n      </div>\n\n      <article class=\"plan-card\">\n        <span class=\"bg-no\">01</span>\n        <div class=\"plan-id\">\n          <h3>基础版</h3>\n          <p class=\"tagline\">给用量不大、设备不多、想先跑一个完整周期的用户。</p>\n          <div class=\"price\">\n            <span class=\"amount\">¥15</span>\n            <span class=\"unit\">/ 月</span>\n          </div>\n          <span class=\"annual\">按年付 ¥150 / 年，约合每月 ¥12.5</span>\n        </div>\n        <ul class=\"plan-list\">\n          <li>每月 100GB 流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>可解锁基础流媒体内容</li>\n          <li>使用普通线路节点池</li>\n        </ul>\n      </article>\n\n      <article class=\"plan-card featured\">\n        <span class=\"bg-no\">02</span>\n        <div class=\"plan-id\">\n          <span class=\"badge\">多数人停在档位</span>\n          <h3>旗舰版</h3>\n          <p class=\"tagline\">给多设备日常使用、对线路优先级有明确要求的人。</p>\n          <div class=\"price\">\n            <span class=\"amount\">¥35</span>\n            <span class=\"unit\">/ 月</span>\n          </div>\n          <span class=\"annual\">按年付 ¥350 / 年，约合每月 ¥29.2</span>\n        </div>\n        <ul class=\"plan-list\">\n          <li>每月 300GB 流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7x24 优先工单支持</li>\n        </ul>\n      </article>\n\n      <article class=\"plan-card\">\n        <span class=\"bg-no\">03</span>\n        <div class=\"plan-id\">\n          <h3>团队版</h3>\n          <p class=\"tagline\">给小团队统一结算、多人同时在线、需要固定路由策略的场景。</p>\n          <div class=\"price\">\n            <span class=\"amount\">¥85</span>\n            <span class=\"unit\">/ 月</span>\n          </div>\n          <span class=\"annual\">按年付 ¥850 / 年，约合每月 ¥70.8</span>\n        </div>\n        <ul class=\"plan-list\">\n          <li>每月 1000GB 流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n      </article>\n\n      <p class=\"plans-foot\">说明：套餐中的流量按自然月计算，未用完的部分不结转。设备数量指同一时间允许在线的设备上限，超出后需要先让其他设备下线。年付与月付的权益内容一致，区别仅在结算周期与折算后的价格。若你对扣费方式有疑问，可在订阅前通过页面下方的问题与说明确认。</p>\n    </div>\n  </section>\n\n  \n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <span class=\"section-no\">03 / 客户端</span>\n        <h2>先确认你手上的设备，再决定怎么接入</h2>\n        <p>水牛云的接入方式以你实际使用的设备为准，此处只做分类与职责说明。</p>\n      </div>\n\n      <div class=\"clients-grid\">\n        <div class=\"client\">\n          <span class=\"num\">A</span>\n          <h3>桌面端</h3>\n          <p>笔记本与台式机是流量消耗最大的设备。如果你的主要用处在办公、资料同步与网页浏览，桌面端通常是第一优先接入的那一台，也建议优先放在旗舰版或团队版的设备名额里。</p>\n          <p class=\"meta\">获取方式：请以订阅后看到的说明为准，本页不提供下载链接。</p>\n        </div>\n        <div class=\"client\">\n          <span class=\"num\">B</span>\n          <h3>移动端</h3>\n          <p>手机和平板适合作为常驻设备，携带方便、切换网络频繁。基础版的 3 台名额里，一台手机加一台电脑是比较常见的组合，第三台可以留给平板。</p>\n          <p class=\"meta\">获取方式：请以订阅后看到的说明为准，本页不提供下载链接。</p>\n        </div>\n        <div class=\"client\">\n          <span class=\"num\">C</span>\n          <h3>多设备与团队设备</h3>\n          <p>当在线设备超过 5 台，或需要为多人分别配置、统一结算时，团队版的 20 台名额与企业定制路由才真正发挥作用。单用户不建议为了“多留名额”而选团队版。</p>\n          <p class=\"meta\">配置细节：请以订阅后看到的说明为准，本页不提供下载链接。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"howto\" class=\"howto\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <span class=\"section-no\">04 / 使用路径</span>\n        <h2>从决定档位到开始使用，四步走完</h2>\n        <p>这四步不涉及任何具体账号操作细节，只描述顺序。</p>\n      </div>\n\n      <div class=\"steps\">\n        <div class=\"step\">\n          <span class=\"s-no\">01</span>\n          <h3>先读价格与权益</h3>\n          <p>把三档套餐的流量、设备数量、线路差异并排看一遍。如果你不确定用量，先按月付，不急着买年付。</p>\n        </div>\n        <div class=\"step\">\n          <span class=\"s-no\">02</span>\n          <h3>确认设备与在线数</h3>\n          <p>数一数同一时间会有几台设备在用。超过名额时，多出来的设备无法同时在线，这是选档时最容易算错的一项。</p>\n        </div>\n        <div class=\"step\">\n          <span class=\"s-no\">03</span>\n          <h3>按对应档位订阅</h3>\n          <p>订阅时请核对页面上显示的周期与金额。本页的年度价格是按年付折算的参考值，实际结算金额以订阅确认页为准。</p>\n        </div>\n        <div class=\"step\">\n          <span class=\"s-no\">04</span>\n          <h3>按说明完成接入</h3>\n          <p>订阅完成后按你看到的使用说明操作。若在使用中发现流量或设备数量与实际需求不符，再考虑调整档位。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <span class=\"section-no\">05 / 常见问题</span>\n        <h2>你可能正在问的几个问题</h2>\n        <p>九个问题，逐条回答，点击展开。</p>\n      </div>\n\n      <div class=\"faq-list\">\n        <details class=\"qa\">\n          <summary>基础版每个月 100GB，够不够我用？</summary>\n          <div class=\"answer\">\n            <p>取决于你的使用习惯。如果主要是图文浏览、即时通讯、偶尔看视频，100GB 通常不会成为束缚；如果你每天有长时间看高清视频、频繁下载大文件的习惯，用量会明显超出，这时更该考虑旗舰版的 300GB。</p>\n            <p>一个务实的做法是：第一个月按月付，结束后看实际消耗，再决定是否升级或转年付。</p>\n          </div>\n        </details>\n\n        <details class=\"qa\">\n          <summary>设备数量是“登录过的设备”还是“同时在线”？</summary>\n          <div class=\"answer\">\n            <p>指同一时间允许在线的设备数量。也就是说，如果你有 4 台设备，但任意时刻只有 3 台在用，基础版仍然可以覆盖；如果 4 台需要一直同时在线，就要选旗舰版。</p>\n          </div>\n        </details>\n\n        <details class=\"qa\">\n          <summary>年付真的更划算吗？</summary>\n          <div class=\"answer\">\n            <p>从单价上看是。基础版年付 ¥150，折算约每月 ¥12.5，低于月付的 ¥15；旗舰版年付 ¥350，折算约每月 ¥29.2；团队版年付 ¥850，折算约每月 ¥70.8。</p>\n            <p>但年付意味着你把使用周期锁定为一年，中途调整档位的灵活度降低。如果你还在摸索自己的用量，建议先用月付跑一个完整周期。</p>\n          </div>\n        </details>\n\n        <details class=\"qa\">\n          <summary>旗舰版的 IPLC 专线游戏加速优化，和基础版差别在哪？</summary>\n          <div class=\"answer\">\n            <p>基础版使用的是普通线路节点池，没有为高并发时段单独设定优先级；旗舰版则在套餐中列明 IPLC 专线游戏加速优化。这两者的区别在于线路类型与优化目标，而不只是价格标签。</p>\n            <p>如果你对延迟比较敏感，或者需要在固定时段保持稳定使用，这部分的差别值得你在选档时重点考虑。</p>\n          </div>\n        </details>\n\n        <details class=\"qa\">\n          <summary>流媒体解锁在三个档位中有什么不同？</summary>\n          <div class=\"answer\">\n            <p>基础版列明的是基础流媒体解锁；旗舰版列明的是全节点原生流媒体解锁；团队版则在节点带宽上做了进一步区分，提供 VIP 专属高带宽节点。</p>\n            <p>如果你把流媒体当作主要使用场景之一，旗舰版在这部分的描述比基础版更完整。</p>\n          </div>\n        </details>\n\n        <details class=\"qa\">\n          <summary>团队版适合一个人用吗？</summary>\n          <div class=\"answer\">\n            <p>不太适合作为默认选择。团队版的 20 台设备名额、企业定制路由与专属客户经理服务，设计对象是需要多人统一结算的小团队。单用户如果没有多设备同时在线与固定路由策略的需求，为这些名额多付费用并不划算。</p>\n          </div>\n        </details>\n\n        <details class=\"qa\">\n          <summary>订阅后在哪里获取客户端？</summary>\n          <div class=\"answer\">\n            <p>本页不提供下载地址，也不提供任何安装包。请以你在订阅完成后看到的使用说明为准，按对应设备的分类说明操作。</p>\n            <p>桌面上优先接入流量最大的那一台，移动端可作为常驻设备，多设备场景再按名额分配。</p>\n          </div>\n        </details>\n\n        <details class=\"qa\">\n          <summary>流量用超了会怎样？可以结转吗？</summary>\n          <div class=\"answer\">\n            <p>套餐中的流量按自然月计算，页面说明中已注明未用完的部分不结转。若你的用量经常接近上限，说明当前档位偏紧，继续按月续费并等待某个月反复超出的成本，通常高于直接升一档。</p>\n          </div>\n        </details>\n\n        <details class=\"qa\">\n          <summary>我能不能中途从月付换成按年付？</summary>\n          <div class=\"answer\">\n            <p>本页只说明价格与权益，不涉及具体的变更流程。稳妥的做法是在当前周期结束前再做调整，这样不会出现两个周期重叠的情况。具体规则请以你订阅时看到的确认信息为准，本页不对未确认的规则作出承诺。</p>\n          </div>\n        </details>\n      </div>\n\n      <p class=\"faq-note\">以上问答仅围绕本页列出的套餐价格、权益与使用顺序展开。水牛云在本页没有给出的信息——包括具体节点清单、实际测速结果、兼容设备列表与退款政策——均不在此处作补充说明，请以你在订阅过程中看到的官方说明为准。</p>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div>\n      <strong>水牛云</strong>\n      <p>本页为水牛云套餐与使用说明的静态说明页，内容围绕三档套餐的价格、流量、设备数量与使用路径展开，不包含下载链接与交易入口。</p>\n      <p>价格与权益以本页列出的信息为准；实际结算与配置细节请以订阅时看到的确认信息为准。</p>\n    </div>\n    <nav class=\"fgrid\" aria-label=\"页脚目录\">\n      <a href=\"#top\">回到顶部</a>\n      <a href=\"#why\">阅读路径</a>\n      <a href=\"#plans\">套餐</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#howto\">使用路径</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n</footer>",
